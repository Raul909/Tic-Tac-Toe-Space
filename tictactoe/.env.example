MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/tictactoe?retryWrites=true&w=majority
NODE_ENV=development
PORT=3000

# Redis — sessions, leaderboard cache, pub/sub
# Leave blank to use in-memory fallback
REDIS_URL=redis://localhost:6379

# RabbitMQ — async stat writes
# Leave blank to use in-process queue fallback
RABBITMQ_URL=amqp://localhost

# OAuth
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
